{
  "name": "@wintermuted/showcase",
  "version": "0.3.1",
  "description": "Versioned static documentation and React examples for Wintermuted UI.",
  "private": true,
  "type": "module",
  "dependencies": {
    "@wintermuted/ui-theme": "1.0.4",
    "@wintermuted/ui-react": "1.3.0",
    "@wintermuted/ui-react-select": "0.1.0"
  },
  "nx": {
    "name": "showcase",
    "tags": ["type:docs"],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/docs/agent-usage.md",
          "{workspaceRoot}/docs/recipes.md",
          "{workspaceRoot}/docs/migration-to-v1.md"
        ]
      }
    },
    "release": {
      "version": { "fallbackCurrentVersionResolver": "disk" }
    }
  }
}
