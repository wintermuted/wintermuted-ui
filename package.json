{
  "name": "wintermuted-ui",
  "private": true,
  "type": "module",
  "license": "MIT",
  "volta": { "node": "22.23.5" },
  "engines": { "node": ">=22.23.5", "npm": ">=10" },
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "node --test tests/*.test.js scripts/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"packages/ui-react/src/**\" --test-coverage-include=\"packages/ui-react-select/src/**\" --test-reporter=spec --test-reporter=./scripts/coverage-reporter.mjs --test-reporter-destination=stdout --test-reporter-destination=stdout tests/react-components.test.js tests/react.test.js",
    "test:browser": "node --test browser-tests/*.test.js",
    "test:pack": "node tests/consumers.mjs --package-only",
    "test:consumers": "node tests/consumers.mjs",
    "test:showcase-output": "node scripts/check-showcase.mjs",
    "showcase:serve": "nx serve showcase",
    "showcase:build": "nx build showcase",
    "showcase:open": "nx serve showcase --open",
    "showcase:open:sample-data": "nx serve showcase --open=/showcase/sample-data.html",
    "showcase:open:forms": "nx serve showcase --open=/showcase/forms.html",
    "showcase:view": "npm run showcase:serve",
    "storybook:serve": "nx serve storybook",
    "storybook:build": "nx build storybook",
    "build": "nx run-many -t build",
    "lint": "nx run ui-theme:lint",
    "typecheck": "nx run-many -t typecheck --projects=ui-react,ui-react-select",
    "graph": "nx graph",
    "release": "node scripts/release.mjs",
    "release:publish": "nx release publish",
    "link:local": "bash scripts/link-local.sh",
    "unlink:local": "bash scripts/unlink-local.sh"
  },
  "devDependencies": {
    "@nx/js": "24.0.6",
    "@nx/vite": "24.0.6",
    "nx": "24.0.6",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.2",
    "jsdom": "^31.0.1",
    "playwright": "^1.56.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2",
    "style-loader": "^4.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "webpack": "^5.102.1"
  }
}
