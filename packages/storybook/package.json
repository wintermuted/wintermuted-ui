{
  "name": "@wintermuted/storybook",
  "private": true,
  "type": "module",
  "description": "Interactive React component development and documentation.",
  "dependencies": {
    "@wintermuted/ui-react": "1.1.0",
    "@wintermuted/ui-theme": "1.0.2",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/react": "^18.3.0 || ^19.0.0",
    "@types/react-dom": "^18.3.0 || ^19.0.0",
    "storybook": "10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "nx": {
    "name": "storybook",
    "tags": ["type:docs"],
    "targets": {
      "serve": {
        "command": "storybook dev --host 127.0.0.1 --port 6006 --exact-port --no-open --disable-telemetry",
        "options": { "cwd": "packages/storybook" },
        "cache": false
      },
      "build": {
        "command": "storybook build --output-dir ../../dist/packages/storybook --disable-telemetry",
        "options": { "cwd": "packages/storybook" },
        "outputs": ["{workspaceRoot}/dist/packages/storybook"]
      },
      "typecheck": {
        "command": "tsc --project packages/storybook/tsconfig.json --noEmit"
      }
    }
  }
}
