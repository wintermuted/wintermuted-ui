{
  "name": "@wintermuted/ui-react",
  "version": "1.1.0",
  "description": "React components and theme utilities for Wintermuted UI.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": { "types": "./src/index.tsx", "default": "./src/index.tsx" },
    "./select": { "types": "./src/select.tsx", "default": "./src/select.tsx" },
    "./theme": { "types": "./src/theme.ts", "default": "./src/theme.ts" }
  },
  "typesVersions": {
    "*": {
      "select": ["src/select.tsx"],
      "theme": ["src/theme.ts"]
    }
  },
  "files": ["src/**/*.js", "src/**/*.d.ts", "README.md", "LICENSE"],
  "scripts": {
    "prepack": "node ../../scripts/block-react-source-pack.mjs"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wintermuted/wintermuted-ui.git",
    "directory": "packages/ui-react"
  },
  "publishConfig": { "registry": "https://registry.npmjs.org", "access": "public" },
  "dependencies": {
    "@wintermuted/ui-theme": "^1.0.2"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-select": "^5.8.0"
  },
  "peerDependenciesMeta": { "react-select": { "optional": true } },
  "nx": {
    "name": "ui-react",
    "tags": ["type:library"],
    "targets": {
      "build": {
        "command": "node scripts/stage-react.mjs",
        "outputs": ["{workspaceRoot}/dist/packages/ui-react"]
      },
      "typecheck": {
        "command": "tsc --project packages/ui-react/tsconfig.json --noEmit"
      },
      "pack": {
        "dependsOn": ["build"],
        "command": "npm pack ./dist/packages/ui-react"
      },
      "nx-release-publish": {
        "executor": "@nx/js:release-publish",
        "dependsOn": ["build"],
        "options": { "packageRoot": "dist/packages/ui-react" }
      }
    }
  }
}
