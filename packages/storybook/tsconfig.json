{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["react", "react-dom", "vite/client"]
  },
  "include": [".storybook/**/*.ts", ".storybook/**/*.tsx", "src/**/*.tsx"]
}
