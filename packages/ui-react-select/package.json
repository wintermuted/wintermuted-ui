{
  "name": "@wintermuted/ui-react-select",
  "version": "0.1.0",
  "description": "Theme-aware react-select components for Wintermuted UI.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": { "types": "./src/index.tsx", "default": "./src/index.tsx" }
  },
  "files": ["src/**/*.js", "src/**/*.d.ts", "README.md", "LICENSE"],
  "scripts": {
    "prepack": "node ../../scripts/block-react-source-pack.mjs"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wintermuted/wintermuted-ui.git",
    "directory": "packages/ui-react-select"
  },
  "publishConfig": { "registry": "https://registry.npmjs.org", "access": "public" },
  "dependencies": {
    "@wintermuted/ui-theme": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-select": "^5.8.0"
  },
  "nx": {
    "name": "ui-react-select",
    "tags": ["type:library"],
    "release": {
      "version": { "fallbackCurrentVersionResolver": "disk" }
    },
    "targets": {
      "build": {
        "command": "node scripts/stage-react.mjs ui-react-select",
        "outputs": ["{workspaceRoot}/dist/packages/ui-react-select"]
      },
      "typecheck": {
        "command": "tsc --project packages/ui-react-select/tsconfig.json --noEmit"
      },
      "pack": {
        "dependsOn": ["build"],
        "command": "npm pack ./dist/packages/ui-react-select"
      },
      "nx-release-publish": {
        "executor": "@nx/js:release-publish",
        "dependsOn": ["build"],
        "options": { "packageRoot": "dist/packages/ui-react-select" }
      }
    }
  }
}
